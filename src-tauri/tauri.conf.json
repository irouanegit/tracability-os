{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracability OS",
  "version": "0.1.27",
  "identifier": "com.tracability.os",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420 https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Tracability OS",
        "width": 1440,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMTlCOUFCQzRGRDU0OTYKUldTV1ZQM0VxN2taTVlNclpCdkNuMWVKbUdVa0J4ZStUNjB0VFpvMjBQVDZ6OExHeGZaTWp0VlMK",
      "endpoints": [
        "https://github.com/Irouane4/tracability-os/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
