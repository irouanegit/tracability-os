GITHUB_RELEASE_REPO=irouanegit/tracability-os
RELEASE_NOTES=Tracability OS release

# Optional bridge for old installed apps that still read Supabase latest.json.
# This uploads only latest.json to Supabase; the installer still downloads from GitHub Releases.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
SUPABASE_RELEASE_BUCKET=app-releases
